# 公開するドメイン（DNSをこのサーバーに向けておくとHTTPS証明書を自動取得）。未設定ならhttp://IP:80
DOMAIN=minamo.example.com

# Claude API キー（未設定なら統計モデルの定型文で動作）
ANTHROPIC_API_KEY=

# 使用モデルと思考の深さ（費用を抑えるなら claude-sonnet-5-5 / low）
MINAMO_MODEL=claude-opus-5-5
MINAMO_EFFORT=medium

# 出走表段階（朝）でもClaudeを呼ぶなら1（呼び出し回数が約2倍）
MINAMO_AI_EARLY=0

# 試験中の買い目を、決めて固定したとき（締切の約5分前）に Discord へ知らせる（Webhook の URL。鍵と同じなので GitHub には置かない）
MINAMO_DISCORD_WEBHOOK=
# 試験中の買い目を決めて固定する、締切の何分前か（既定 5.5。人が買えるのは5〜3分前まで）
MINAMO_PICK_FIX_MIN=5.5
